<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.VTroid" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryDark">@color/black</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <!-- Customize your theme here. -->
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:windowContentTransitions">true</item>

    </style>

    <style name="roundedImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="roundedImageView50dp">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeBottomLeft">130dp</item>
        <item name="cornerSizeBottomRight">130dp</item>
    </style>

    <style name="roundedImageView35dp">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>

    </style>

    <style name="FullScreenTheme" parent="Theme.VTroid">
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/teal_200</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

    <style name="TransparentNoti" parent="Theme.VTroid">
        <item name="android:navigationBarColor">@color/black</item>

        <!-- Optional: set to transparent if your app is drawing behind the status bar. -->
        <item name="android:statusBarColor">@color/fui_transparent</item>
    </style>

    <style name="navigationTheme">
        <item name="colorPrimary">@color/white</item>
        <item name="android:listDivider">@color/darkCustomGrey</item>
        <item name="colorControlHighlight">@color/black</item>
    </style>

    <style name="SCBSwitch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="colorControlActivated">@color/white</item>
        <item name="colorSwitchThumbNormal">#ffffff</item>
        <item name="colorAccent">#ffffff</item>
    </style>

    <style name="BottomSheetTheme" parent="Theme.Design.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="MineCustomTabTextVideo" parent="TextAppearance.Design.Tab">
        <item name="android:textSize" tools:ignore="SpUsage">15dp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="PreferenceScreen" parent="Theme.VTroid">
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorTertiary">@color/white</item>
        <item name="android:textColorSecondary">@color/white</item>
    </style>

    <style name="MyDialogStyle" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMinor">75%</item>
    </style>

</resources>